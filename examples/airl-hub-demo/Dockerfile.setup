# syntax=docker/dockerfile:1
# Одноразовый контейнер установки хранилища: роли, слои, модули, синтетика, пользователи, ИИ-сводка.
# Контекст сборки — корень репозитория airl-skills (нужны скрипты skills/airl-ai).
FROM node:22-alpine
# За корпоративным прокси с подменой сертификата передайте его: --secret id=ca,src=<файл CA>
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then cat /run/secrets/ca >> /etc/ssl/certs/ca-certificates.crt; fi; \
    apk add --no-cache bash postgresql16-client python3 py3-psycopg
WORKDIR /demo
COPY skills/airl-ai/scripts /skills/airl-ai/scripts
COPY examples/airl-hub-demo/services/package.json examples/airl-hub-demo/services/package-lock.json services/
# Корпоративный прокси с своим сертификатом (необязательно): --secret id=ca,src=<файл CA>
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export NPM_CONFIG_CAFILE=/run/secrets/ca; fi; \
    cd services && npm ci --omit=dev --no-audit --no-fund
COPY examples/airl-hub-demo/data data
COPY examples/airl-hub-demo/dwh dwh
COPY examples/airl-hub-demo/scripts scripts
COPY examples/airl-hub-demo/ai ai
COPY examples/airl-hub-demo/services/hub/create_users.js services/hub/create_users.js
ENV SKILLS_DIR=/skills
CMD ["sh", "-c", "touch .env && bash scripts/setup_db.sh && bash ai/run_digest.sh"]
