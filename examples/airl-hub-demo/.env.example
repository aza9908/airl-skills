# Образец переменных. Настоящий .env создаёт scripts/init_env.sh (случайные пароли) — в git он не попадает.
# Значения ниже пустые намеренно.

# Администратор PostgreSQL — только для установки (scripts/setup_db.sh). В docker compose строится из ADMIN_DB_PASSWORD.
ADMIN_DATABASE_URL=
ADMIN_DB_PASSWORD=
DB_NAME=airl_demo_hub

# Пароль демо-пользователей хаба (ceo, head_*, staff_*). Выдаёт команда AIRL, в карту и git не пишется.
DEMO_PASSWORD=

# Пользователи базы: загрузка, сервисы отделов, оболочка хаба, ИИ-слой (только чтение).
LOADER_DB_PASSWORD=
FIN_DB_PASSWORD=
SALES_DB_PASSWORD=
EDU_DB_PASSWORD=
HUB_DB_PASSWORD=
AI_DB_PASSWORD=

# Контракт входа (COMPANY_MAP.md, раздел 8)
AIRL_ISSUER=https://hub.airl.kz
AIRL_AUDIENCE=airl-hub
# 0 — только для отладки по http без localhost; по умолчанию cookie с флагом Secure
COOKIE_SECURE=

# Сервер хаба: домен для Caddy (сертификат) и порт локального прокси
HUB_SITE=
PROXY_PORT=8080

# ИИ-сводка (/airl-ai): без ключа — шаблонная сводка без модели. Ключ — только на сервере.
ANTHROPIC_API_KEY=
