# Образец файла .env — ИМЕНА переменных без значений. Пишет /airl-devops (и /airl-dwh,
# /airl-cybersecurity дополняют). Этот файл лежит в git; настоящий .env — нет.
# Как пользоваться: скопируй файл, назови копию .env, впиши значения после «=».
# Значения в чат не вставлять. На сервере .env лежит с правами 600 (только владелец).

# Приложение
APP_PORT=
APP_VERSION=
# Свой продукт: base_path «/»; сервис хаба: /<id>
BASE_PATH=

# База: пользователь приложения, НЕ администратор базы (в хабе — svc_<отдел>)
DATABASE_URL=

# Вход: свой продукт — ключи провайдера; хаб — из карты, раздел 8, «Контракт входа»
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_COOKIE_NAME=

# Внешние сервисы (только нужные; ключи с минимальными правами)
# AMOCRM_TOKEN=
# BITRIX24_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
